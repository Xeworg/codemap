{
  "name": "codemap",
  "description": "Go symbol indexer: query definitions, file locations, signatures, and commit history. Use before editing or reasoning about code.",
  "version": "1.0",
  "tools": [
    {
      "name": "codemap_index",
      "description": "Scan and index all Go source files in a repository. Creates or updates the symbol DB. Safe to re-run (incremental).",
      "command": "codemap index",
      "arguments": [],
      "flags": [
        {
          "name": "--db",
          "type": "string",
          "description": "Path to SQLite DB (optional; default: ~/.cache/codemap/<repo-hash>.db)",
          "required": false
        },
        {
          "name": "-repo",
          "type": "string",
          "description": "Repository root to index (optional; default: current directory)",
          "required": false
        }
      ],
      "output": {
        "schema": "1.0",
        "fields": {
          "ok": "bool — true if run completed",
          "data.files_scanned": "int — total .go files discovered",
          "data.files_parsed": "int — files successfully parsed",
          "data.symbols_found": "int — symbols extracted",
          "data.parse_errors": "int — files that failed to parse (fail-soft)",
          "meta.snapshot_id": "int — ID of this snapshot",
          "meta.is_stale": "bool — true if older than 24h"
        },
        "example": {
          "schema_version": "1.0",
          "command": "index",
          "ok": true,
          "data": {
            "files_scanned": 51,
            "files_parsed": 50,
            "symbols_found": 247,
            "parse_errors": 1
          },
          "errors": [],
          "meta": {
            "snapshot_id": 1,
            "head_ref": "refs/heads/main",
            "indexed_at": "2026-05-21T10:00:00Z",
            "is_stale": false
          }
        }
      },
      "exit_codes": {
        "0": "Success",
        "1": "Runtime error (DB/file)",
        "2": "Validation error (missing repo)",
        "3": "Data state error"
      }
    },
    {
      "name": "codemap_symbol",
      "description": "Look up a Go symbol by name. Returns definition, file, line range, signature, and confidence.",
      "command": "codemap symbol <name>",
      "arguments": [
        {
          "name": "name",
          "type": "string",
          "description": "Symbol name to look up",
          "required": true
        }
      ],
      "flags": [
        {
          "name": "--db",
          "type": "string",
          "description": "Path to SQLite DB (optional; default: ~/.cache/codemap/<repo-hash>.db)",
          "required": false
        }
      ],
      "output": {
        "schema": "1.0",
        "fields": {
          "ok": "bool — true if symbol found",
          "data.name": "string — symbol name",
          "data.kind": "string — func|type|interface|var|const",
          "data.signature": "string — signature (params only in MVP)",
          "data.start_line": "int — line where symbol starts",
          "data.end_line": "int — line where symbol ends",
          "data.file": "string — relative file path",
          "data.confidence": "string — high|medium|low",
          "data.evidence": "array — evidence entries",
          "meta.snapshot_id": "int",
          "meta.is_stale": "bool"
        },
        "example": {
          "schema_version": "1.0",
          "command": "symbol",
          "ok": true,
          "data": {
            "name": "RunIndex",
            "kind": "func",
            "signature": "func(ctx, w, args, repoRoot)",
            "start_line": 17,
            "end_line": 154,
            "file": "packages/coding-agent/codemap/cli/index.go",
            "confidence": "high",
            "evidence": [
              {"type": "direct", "description": "symbol extracted from source"},
              {"type": "file_location", "description": "found in packages/coding-agent/codemap/cli/index.go"}
            ]
          },
          "errors": [],
          "meta": {
            "snapshot_id": 1,
            "head_ref": "refs/heads/main",
            "indexed_at": "2026-05-21T10:00:00Z",
            "is_stale": false
          }
        }
      },
      "exit_codes": {
        "0": "Success (symbol found)",
        "1": "Runtime error (DB/file)",
        "2": "Validation error (missing name)",
        "3": "Not found (no index or symbol absent)"
      }
    },
    {
      "name": "codemap_history",
      "description": "Query commit history for a Go symbol. Returns commits ordered by link strength (strong > medium > weak) and recency.",
      "command": "codemap history <name>",
      "arguments": [
        {
          "name": "name",
          "type": "string",
          "description": "Symbol name to query history for",
          "required": true
        }
      ],
      "flags": [
        {
          "name": "--db",
          "type": "string",
          "description": "Path to SQLite DB (optional; default: ~/.cache/codemap/<repo-hash>.db)",
          "required": false
        }
      ],
      "output": {
        "schema": "1.0",
        "fields": {
          "ok": "bool — true if query ran",
          "data.symbol_name": "string",
          "data.confidence": "string — medium if history found, low otherwise",
          "data.evidence": "array — commit_link entries with commit_hash, description, link_strength",
          "meta.snapshot_id": "int",
          "meta.is_stale": "bool"
        },
        "example": {
          "schema_version": "1.0",
          "command": "history",
          "ok": true,
          "data": {
            "symbol_name": "RunIndex",
            "confidence": "medium",
            "evidence": [
              {
                "type": "commit_link",
                "description": "modify on 2026-05-21 (a3f9c1d2)",
                "source": "a3f9c1d2",
                "link_strength": "strong"
              }
            ]
          },
          "errors": [],
          "meta": {
            "snapshot_id": 1,
            "head_ref": "refs/heads/main",
            "indexed_at": "2026-05-21T10:00:00Z",
            "is_stale": false
          }
        }
      },
      "exit_codes": {
        "0": "Success",
        "1": "Runtime error",
        "2": "Validation error",
        "3": "Not found (no index or symbol absent)"
      }
    }
  ],
  "install_notes": {
    "binary": "go build -o codemap ./cmd/codemap",
    "db_default": "~/.cache/codemap/<repo-hash>.db",
    "db_env": "CODEMAP_DB_PATH",
    "auto_index": "If DB is missing, codemap index auto-creates it on first run"
  }
}